<?xml version="1.0" encoding="utf-8"?>
<!-- Repeatable Design Element: Bottom Navigation Footer Bar with 5 Equally Spaced Actions -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="72dp"
    android:background="?attr/colorSurface"
    android:elevation="8dp"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="4dp">

    <!-- Page 0: Terminal Button -->
    <LinearLayout
        android:id="@+id/btn_nav_terminal"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/icon_terminal"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:contentDescription="Terminal"
            android:tint="?attr/colorOnSurfaceVariant" />

        <TextView
            android:id="@+id/label_terminal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Terminal"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- Page 1: Placeholder / Tools Button -->
    <LinearLayout
        android:id="@+id/btn_nav_placeholder"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/icon_placeholder"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:contentDescription="Placeholder"
            android:tint="?attr/colorOnSurfaceVariant" />

        <TextView
            android:id="@+id/label_placeholder"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tools"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- Page 2: Center Home / Thumb-Sized Circular Add Button -->
    <FrameLayout
        android:id="@+id/btn_nav_home_container"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:gravity="center">

        <ImageButton
            android:id="@+id/btn_nav_home_circle"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_gravity="center"
            android:background="?attr/colorPrimary"
            android:contentDescription="Add Elements / Home"
            android:elevation="6dp"
            android:src="@android:drawable/ic_input_add"
            android:tint="?attr/colorOnPrimary" />
    </FrameLayout>

    <!-- Page 3: Gallery Button -->
    <LinearLayout
        android:id="@+id/btn_nav_gallery"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/icon_gallery"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:contentDescription="Gallery"
            android:tint="?attr/colorOnSurfaceVariant" />

        <TextView
            android:id="@+id/label_gallery"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Gallery"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- Page 4: Settings Button -->
    <LinearLayout
        android:id="@+id/btn_nav_settings"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/icon_settings"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:contentDescription="Settings"
            android:tint="?attr/colorOnSurfaceVariant" />

        <TextView
            android:id="@+id/label_settings"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Settings"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="11sp" />
    </LinearLayout>
</LinearLayout>
